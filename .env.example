# Better Auth

# Service endpoints and bounded proxy policy
# Internal Relay origin used only by server-side routes.
LCE_RELAY_URL=http://relay:3009
LCE_RELAY_REQUEST_TIMEOUT_MS=15000
LCE_MODEL_CONFIG_SAVE_PROXY_TIMEOUT_MS=140000
LCE_MODEL_DISCOVERY_PROXY_TIMEOUT_MS=30000
LCE_PLATFORM_MODEL_CONFIG_BODY_LIMIT_BYTES=65536
LCE_PLATFORM_MODEL_CONFIG_RESPONSE_LIMIT_BYTES=65536
LCE_PROVIDER_MODEL_DISCOVERY_RESPONSE_LIMIT_BYTES=1048576
# Public site origin used for metadata; BETTER_AUTH_URL is the fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional package registry origin used to resolve the published client version.
LCE_PACKAGE_REGISTRY_URL=https://registry.npmjs.org
# Client launch policy is deployment-owned. Set commands supported by your target environment.
# If both launcher settings are empty, the console disables configuration copying instead of guessing a command.
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_RUNNER=
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_RUNNER_ARGS=[]
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_NAME=@anmezing/lce-cloud
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_TAG=latest
NEXT_PUBLIC_LCE_CLIENT_GLOBAL_EXECUTABLE=
LCE_CLIENT_VERSION_CACHE_SECONDS=900
LCE_MODEL_DISCOVERY_RESULT_LIMIT=500
LCE_ADMIN_LOG_PAGE_SIZE=50

# Shared calendar boundary for quotas/leaderboard. Keep server and public values identical.
APPLICATION_TIMEZONE=Asia/Shanghai
NEXT_PUBLIC_APPLICATION_TIMEZONE=Asia/Shanghai

# Browser polling and feedback policy (build-time NEXT_PUBLIC values)
NEXT_PUBLIC_INDEX_POLL_ACTIVE_MS=5000
NEXT_PUBLIC_INDEX_POLL_IDLE_MS=30000
NEXT_PUBLIC_LOGS_AUTO_REFRESH_MS=5000
NEXT_PUBLIC_LOGS_PAGE_SIZE=20
NEXT_PUBLIC_LEADERBOARD_REFRESH_MS=30000
NEXT_PUBLIC_LEADERBOARD_DATE_OPTION_COUNT=3
NEXT_PUBLIC_PAYMENT_STATUS_POLL_MS=2000
NEXT_PUBLIC_HEALTH_HISTORY_LIMIT=60
NEXT_PUBLIC_HEALTH_LATEST_LIMIT=1
NEXT_PUBLIC_HEALTH_RESULT_POLL_MS=5000
NEXT_PUBLIC_HEALTH_RESULT_POLL_ATTEMPTS=12
NEXT_PUBLIC_HEALTH_COUNTDOWN_TICK_MS=1000
NEXT_PUBLIC_HEALTH_SLOW_THRESHOLD_MS=5000
NEXT_PUBLIC_HOVER_INTENT_MS=120
NEXT_PUBLIC_NOTICE_DURATION_MS=2000
NEXT_PUBLIC_INVITATION_REDIRECT_MS=1200
NEXT_PUBLIC_MINIMUM_LOADING_FEEDBACK_MS=300

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here
# Comma-separated CIDRs for reverse proxies allowed to supply X-Forwarded-For.
# Empty disables forwarded client IPs and uses Better Auth's shared fallback
# rate-limit key. Production deployments should list every trusted proxy hop.
BETTER_AUTH_TRUSTED_PROXIES=

# LinuxDo OAuth
AUTH_LINUXDO_ID=your-linuxdo-client-id
AUTH_LINUXDO_SECRET=your-linuxdo-client-secret

# GitHub OAuth
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# If using a GitHub App (not OAuth App), enable Account Permissions > Email Addresses: Read-Only
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret
# Minimum GitHub account age in days for new signups; invalid/unset defaults to 365; 0 disables the check
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_MAX_PASSWORD_LENGTH=128
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=3600
AUTH_ORGANIZATION_INVITATION_TTL_SECONDS=172800

# Credential sign-up email verification (required for email registration)
# SMTP_PORT defaults to 587; set SMTP_SECURE=true for implicit TLS (usually port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password
POSTGRES_DB=postgres

# Redis; REDIS_URL takes precedence when set.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# 套餐支付回调公网地址；生产环境必须是支付平台可访问的 HTTPS origin。
# 未配置对应商户参数时，控制台会将该支付渠道显示为不可用，不会生成假订单。
PAYMENT_NOTIFY_BASE_URL=http://localhost:3000
PAYMENT_PROVIDER_REQUEST_TIMEOUT_MS=10000
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
PAYMENT_ORDER_TTL_MINUTES=15

# 支付宝当面付（alipay.trade.precreate）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 可选：PKCS1（默认）或 PKCS8；卖家 ID 配置后回调会额外校验。
ALIPAY_KEY_TYPE=PKCS1
ALIPAY_SELLER_ID=
# 可选，默认使用支付宝正式环境。
ALIPAY_ENDPOINT=

# 微信支付 API v3 Native
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
# 可选，默认 https://api.mch.weixin.qq.com
WECHAT_PAY_API_BASE_URL=

# Admin: comma-separated login emails granted admin sections in the console,
# e.g. ADMIN_EMAILS=me@example.com,ops@example.com (case-insensitive match
# against the OAuth account email). Read at runtime by /api/admin/check.
ADMIN_EMAILS=

# Shown in the admin console for display only (must match the values passed to
# acemcp-relay / lce in deploy): default per-user daily request limit (0 =
# unlimited) and LCE model config.
DEFAULT_DAILY_REQUEST_LIMIT=0
DAILY_INDEX_BYTES_LIMIT=2147483648
PRO_DAILY_REQUEST_LIMIT=0
PRO_DAILY_INDEX_BYTES_LIMIT=0
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_BASE_URL=
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_BASE_URL=

# Per-user BYO model config (console "模型设置"). Set the SAME value here and
# on acemcp-relay; user model configs (incl. their API keys) are stored
# AES-256-GCM encrypted with this secret. Leave empty to disable the feature.
MODEL_CONFIG_SECRET=
