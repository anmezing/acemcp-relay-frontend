# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here
# Comma-separated CIDRs for reverse proxies allowed to supply X-Forwarded-For.
BETTER_AUTH_TRUSTED_PROXIES=

# LinuxDo OAuth
AUTH_LINUXDO_ID=your-linuxdo-client-id
AUTH_LINUXDO_SECRET=your-linuxdo-client-secret

# GitHub OAuth
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# If using a GitHub App (not OAuth App), enable Account Permissions > Email Addresses: Read-Only
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret
# Minimum GitHub account age in days for new signups; invalid/unset defaults to 365; 0 disables the check
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password
POSTGRES_DB=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 套餐支付回调公网地址；生产环境必须是支付平台可访问的 HTTPS origin。
# 未配置对应商户参数时，控制台会将该支付渠道显示为不可用，不会生成假订单。
PAYMENT_NOTIFY_BASE_URL=http://localhost:3000

# 支付宝当面付（alipay.trade.precreate）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 可选：PKCS1（默认）或 PKCS8；卖家 ID 配置后回调会额外校验。
ALIPAY_KEY_TYPE=PKCS1
ALIPAY_SELLER_ID=
# 可选，默认使用支付宝正式环境。
ALIPAY_ENDPOINT=

# 微信支付 API v3 Native
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
# 可选，默认 https://api.mch.weixin.qq.com
WECHAT_PAY_API_BASE_URL=

# Admin: comma-separated login emails granted admin sections in the console,
# e.g. ADMIN_EMAILS=me@example.com,ops@example.com (case-insensitive match
# against the OAuth account email). Read at runtime by /api/admin/check.
ADMIN_EMAILS=

# Shown in the admin console for display only (must match the values passed to
# acemcp-relay / lce in deploy): default per-user daily request limit (0 =
# unlimited) and LCE model config.
DEFAULT_DAILY_REQUEST_LIMIT=0
DAILY_INDEX_BYTES_LIMIT=2147483648
PRO_DAILY_REQUEST_LIMIT=0
PRO_DAILY_INDEX_BYTES_LIMIT=0
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_BASE_URL=
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_BASE_URL=

# Per-user BYO model config (console "模型设置"). Set the SAME value here and
# on acemcp-relay; user model configs (incl. their API keys) are stored
# AES-256-GCM encrypted with this secret. Leave empty to disable the feature.
MODEL_CONFIG_SECRET=
