# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here

# LinuxDo OAuth
AUTH_LINUXDO_ID=your-linuxdo-client-id
AUTH_LINUXDO_SECRET=your-linuxdo-client-secret

# GitHub OAuth
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# If using a GitHub App (not OAuth App), enable Account Permissions > Email Addresses: Read-Only
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret
# Minimum GitHub account age in days for new signups; invalid/unset defaults to 365; 0 disables the check
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password
POSTGRES_DB=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Device binding: how many devices may stay signed in per user. Default 1 =
# single active device — a new device login evicts the previous one (evicted
# device gets 401 from acemcp-relay in enforce mode and must log in again).
# When a login evicts another device, the API token is also rotated, so any
# copied token dies with the evicted device. Re-login from the same machine
# (multiple IDEs/windows share one machineId) never evicts or rotates.
MAX_DEVICES_PER_USER=1

# Admin: comma-separated login emails granted admin sections in the console,
# e.g. ADMIN_EMAILS=me@example.com,ops@example.com (case-insensitive match
# against the OAuth account email). Read at runtime by /api/admin/check.
ADMIN_EMAILS=

# Shown in the admin console for display only (must match the values passed to
# acemcp-relay / lce in deploy): default per-user daily request limit (0 =
# unlimited) and LCE model config.
DEFAULT_DAILY_REQUEST_LIMIT=0
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_BASE_URL=
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_BASE_URL=
